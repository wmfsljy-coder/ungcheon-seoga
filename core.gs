    libMatch:function(a,p){admin(a);
      /* DLS 서명은 "코스모스 : 보급판", "넛지 = Nudge", "아몬드 (양장)" 꼴이 많아 부제 앞부분도 같이 본다.
         "1984년의 기록" 처럼 앞글자만 같은 다른 책은 맞추지 않는다 */
      var set={},n=0;
      S(p.text).split(/[\r\n\t]+/).forEach(function(l){
        [l,l.split(/\s[:=]\s|[(\[\/]/)[0]].forEach(function(x){x=norm(x);if(x.length>1){set[x]=true;n++;}});});
      if(!n)fail("붙여넣은 목록이 비어 있습니다.");
      var hit=0,miss=[];
      db.rows("도서").forEach(function(b){
        var ok=!!set[norm(b["제목"])];
        if(ok)hit++;else miss.push(S(b["제목"]));
        if((S(b["소장"])==="Y")!==ok)db.set("도서","id",S(b["id"]),{"소장":ok?"Y":"N"});
      });
      return {hit:hit,miss:miss};},
    noticeAdd:function(a,p){admin(a);
      var title=S(p.title).slice(0,60),body=S(p.body).slice(0,300);
      if(!title)fail("공지 제목을 적어 주세요.");
      db.add("공지",{"id":"n"+env.uid(),"시작":S(p.from),"끝":S(p.to),"제목":title,"내용":body,"대상":["학생","교사","모두"].indexOf(S(p.who))>=0?S(p.who):"학생","숨김":"","시각":stamp(env.now())});
      return {ok:true};},
    noticeHide:function(a,p){admin(a);db.set("공지","id",S(p.id),{"숨김":p.on?"Y":""});},
    quizPick:function(a,p){admin(a);db.set("퀴즈","id",S(p.id),{"상태":"출제","주":weekKey(env.now(),p.next?1:0)});},
    quizDrop:function(a,p){admin(a);db.set("퀴즈","id",S(p.id),{"상태":"반려","주":""});},
    quizAdd:function(a,p){admin(a);
      var o=[S(p.o1),S(p.o2),S(p.o3),S(p.o4)],ans=Number(p.ans);
      if(!S(p.book)||S(p.q).length<5||o.some(function(x){return !x;})||!(ans>=1&&ans<=4))fail("책, 문제, 보기 네 개, 정답 번호를 적어 주세요.");
      db.add("퀴즈",{"id":"q"+env.uid(),"시각":stamp(env.now()),"차수":conf()["차수"],"주":weekKey(env.now(),p.next?1:0),"상태":"출제",
        "책제목":S(p.book),"쪽수":S(p.page),"문제":S(p.q),"보기1":o[0],"보기2":o[1],"보기3":o[2],"보기4":o[3],"정답":ans,"해설":S(p.why),"학번":"","반":"교사","출처":"교사"});},
    quizAuto:function(a){admin(a);return ensureWeeklyQuiz();}
  };

  /* 교사가 학생 화면을 본다. as="blank" 는 아직 아무것도 안 한 학생, 학번이면 그 학생(담임은 자기 반만). 읽기만 된다 */
  function previewState(a,as){
    var c=conf(),r=null;
    if(as!=="blank"){
      r=db.rows("명단").filter(function(x){return S(x["학번"])===S(as);})[0];
      if(!r)fail("명단에 없는 학번입니다.");
      if(!seeCls(a,S(r["반"])))fail("우리 학년 학생만 볼 수 있습니다.");
    }
    var who_=r?{role:"student",id:S(r["학번"]),name:S(r["이름"]),cls:S(r["반"])}
              :{role:"student",id:"__preview__",name:"미리보기 학생",cls:"미리보기"};
    var st=studentState(who_);
    st.preview={teacher:a.name,as:r?S(r["학번"]):"",admin:a.role==="admin"};
    return st;
  }

  function api(name,p){
    p=p||{};
    if(name==="login")return login(p);
    if(name==="logout")return logout(p);
    var a=who(p);
    if(a.role==="nologin"){
      if(name==="state")return {need:"login",conf:pubConf(conf())};
      fail("LOGIN");
    }
    if(a.role==="guest"&&pinMode()){
      if(name==="state")return {need:"login",conf:pubConf(conf())};
      fail("LOGIN");
    }
    if(a.role==="guest"){
      if(name==="state")return {need:"register",email:a.email,conf:pubConf(conf())};
      if(name==="register")return register(a,p);
      fail("먼저 학번과 이름을 등록해 주세요.");
    }
    /* 교사가 명단에 이메일을 미리 넣어 둔 학생도 처음 한 번은 동의를 받는다 */
    if(a.role==="student"&&!a.agreed){
      if(name==="state")return {need:"consent",email:a.email,name:a.name,conf:pubConf(conf())};
      if(name==="consent"){
        if(p.agree!==true)fail("동의해야 참여할 수 있습니다.");
        db.set("명단","학번",a.id,{"동의":stamp(env.now())});return {ok:true};
      }
      fail("먼저 개인정보 수집·이용에 동의해 주세요.");
    }
    if(name==="libSearch")return libSearch(a,p);
    if(name==="state"){
      if(p.as&&a.role!=="student")return previewState(a,S(p.as));
      return a.role==="student"?studentState(a):teacherState(a);
    }
    if(name==="submit")return submit(a,p);
    if(name==="vote")return vote(a,p);
    if(name==="like")return like(a,p);
    if(name==="staffLabel")return staffLabel(a,p);
    if(name==="quizAnswer")return quizAnswer(a,p);
    if(name==="quizSubmit")return quizSubmit(a,p);
    if(OPS[name])return OPS[name](a,p)||{ok:true};
    fail("알 수 없는 요청입니다.");
  }
  function selfTest(budgetMs){
    var t0=Date.now(),out={checks:[],timing:{}},c=conf(),mon=S(c["이달"]),wk=weekKey(env.now(),0);
    function chk(name,ok,detail){out.checks.push({name:name,ok:!!ok,detail:detail||""});}
    /* 설정 */
    chk("이달 형식",/^\d{4}-\d{2}$/.test(mon),mon);
    chk("로그인 방식",["핀","구글"].indexOf(S(c["로그인방식"]))>=0,S(c["로그인방식"]));
    /* 명단 */
    var st=db.rows("명단"),seen={},dupHb=[],badHb=[],badCls=[],noName=[],mails={},dupMail=[];
    st.forEach(function(r){
      var hb=S(r["학번"]),cl=S(r["반"]);
      if(seen[hb])dupHb.push(hb);seen[hb]=1;
      if(!/^\d{4}$/.test(hb))badHb.push(hb||"(빈칸)");
      else if(cl!==hb.charAt(0)+"-"+Number(hb.slice(1,2)))badCls.push(hb+":"+cl);
      if(!S(r["이름"]))noName.push(hb);
      var m=lower(r["이메일"]);if(m){if(mails[m])dupMail.push(hb);mails[m]=1;}
    });
    chk("명단 인원",st.length>0,st.length+"명");
    chk("학번 중복 없음",!dupHb.length,dupHb.slice(0,10).join(","));
    chk("학번 4자리",!badHb.length,badHb.slice(0,10).join(","));
    chk("반이 학번과 맞음",!badCls.length,badCls.slice(0,10).join(","));
    chk("이름 빈칸 없음",!noName.length,noName.slice(0,10).join(","));
    chk("학생 메일 중복 없음",!dupMail.length,dupMail.slice(0,10).join(","));
    var grades={};st.forEach(function(r){var g=S(r["학번"]).charAt(0);grades[g]=(grades[g]||0)+1;});
    chk("학년별 인원",true,JSON.stringify(grades));
    /* 교사 */
    var te=db.rows("교사"),names={},dupName=[],badDam=[],tm={},dupTM=[],kinds={};
    te.forEach(function(r,i){
      var nm=S(r["이름"]).replace(/\s/g,""),d=S(r["담당"]).replace(/\s/g,"");
      if(nm){if(names[nm]&&!S(r["이메일"]))dupName.push("줄"+(i+2));names[nm]=1;}
      if(d&&!/^(전체|관리자|교사|\d학년|\d|\d-\d+)$/.test(d))badDam.push("줄"+(i+2)+":"+d);
      var m=lower(r["이메일"]);if(m){if(tm[m])dupTM.push("줄"+(i+2));tm[m]=1;}
      var k=staffOf(r).label.replace(/\d학년 담당/,"학년 담당");kinds[k]=(kinds[k]||0)+1;
    });
    chk("교사 인원",te.length>0,te.length+"명 "+JSON.stringify(kinds));
    chk("관리자 1명 이상",!!kinds["관리자"],"");
    chk("교사 이름 겹침 없음(이름으로 메일 연결)",!dupName.length,dupName.join(","));
    chk("교사 담당 값",!badDam.length,badDam.join(","));
    chk("교사 메일 중복 없음",!dupTM.length,dupTM.join(","));
    var both=0;te.forEach(function(r){var m=lower(r["이메일"]);if(m&&mails[m])both++;});
    chk("교사·학생 메일 겹침 없음",!both,both?both+"건":"");
    /* 서가 */
    var bl=bookList(),noCall=bl.filter(function(b){return !b.call;}).length,gen={};
    bl.forEach(function(b){gen[b.s]=(gen[b.s]||0)+1;});
    chk("이번 달 서가",bl.length>=20,bl.length+"권 · 분야 "+Object.keys(gen).length+"개");
    chk("청구기호 있음",noCall===0,noCall?noCall+"권 없음":"");
    var rows=db.rows("도서").filter(function(b){return visibleBook(b,mon);}),intro=rows.filter(function(b){var x=S(b["소개"]);return x&&x!=="-";}).length;
    chk("책 소개 받음",intro>=rows.length*0.6,intro+"/"+rows.length);
    /* 퀴즈 */
    var live=db.rows("퀴즈").filter(function(q){return S(q["상태"])==="출제"&&S(q["주"])===wk;}),bad=[],bk={};
    live.forEach(function(q){
      var o=[1,2,3,4].map(function(i){return S(q["보기"+i]);}),a=Number(q["정답"]);
      if(o.some(function(x){return !x;})||!(a>=1&&a<=4)||new Set(o.map(norm)).size<4)bad.push(S(q["id"]));
      bk[tkey(q["책제목"])]=1;
    });
    chk("이번 주 퀴즈 문항",live.length===(Number(c["퀴즈문항수"])||5),live.length+"문제");
    chk("이번 주 퀴즈 책 3권 이하",Object.keys(bk).length<=(Number(c["퀴즈책수"])||3),Object.keys(bk).length+"권");
    chk("퀴즈 보기·정답 정상",!bad.length,bad.join(","));
    var bank=db.rows("퀴즈").filter(function(q){return S(q["상태"])==="예비"&&S(q["월"])===mon;}).length;
    chk("문제 은행",bank>=10,bank+"문제");
    var nq=db.rows("문장").filter(function(r){return S(r["문장"])&&S(r["숨김"])!=="Y";}).length;
    chk("오늘의 문장",nq>=100,nq+"개 · 오늘: "+todayQuote().src);
    /* 화면: 교사 전원, 학생 전원(시간 안에서) */
    var tErr=[],tMax=0,t1=Date.now();
    te.forEach(function(r,i){
      var a=staffOf(r);a.id=a.email=lower(r["이메일"])||"x"+i;a.name=S(r["이름"]);a.seen="";a.rowEmail=S(r["이메일"]);
      var s0=Date.now();
      try{STAMPS=null;STARS=null;PAIDW=null;var v=teacherState(a);if(!v.me)throw new Error("빈 화면");}catch(e){tErr.push("줄"+(i+2)+":"+e.message);}
      tMax=Math.max(tMax,Date.now()-s0);
    });
    out.timing.teacherAvgMs=Math.round((Date.now()-t1)/Math.max(te.length,1));out.timing.teacherMaxMs=tMax;
    chk("교사 화면 전원 열림",!tErr.length,tErr.slice(0,5).join(" / "));
    var sErr=[],sMax=0,n=0,t2=Date.now(),budget=budgetMs||150000;
    for(var i=0;i<st.length;i++){
      if(Date.now()-t0>budget)break;
      var r=st[i],a={role:"student",id:S(r["학번"]),email:lower(r["이메일"]),name:S(r["이름"]),cls:S(r["반"]),agreed:true,club:S(r["도서부"])==="Y"};
      var s1=Date.now();
      try{var v2=studentState(a);if(!v2.me||!v2.books)throw new Error("빈 화면");}catch(e){sErr.push(a.id+":"+e.message);}
      sMax=Math.max(sMax,Date.now()-s1);n++;
    }
    out.timing.studentAvgMs=Math.round((Date.now()-t2)/Math.max(n,1));out.timing.studentMaxMs=sMax;
    chk("학생 화면 열림",!sErr.length&&n>0,n+"/"+st.length+"명 확인"+(sErr.length?" · "+sErr.slice(0,5).join(" / "):""));
    try{var dk=deskFor(c,ALL_CLS);chk("도서부 배부 화면",!!dk,dk.none?"배부 기간 아님":dk.rows.length+"명 대상");}catch(e){chk("도서부 배부 화면",false,e.message);}
    /* ── 문 열기 전 준비(못 하면 경고만, 막지는 않음) ── */
    var reg=st.filter(function(r){return S(r["핀"]);}).length;
    var tch=db.rows("교사"),tReg=tch.filter(function(r){return S(r["핀"]);}).length;
    var locked=st.filter(function(r){return lockLeft(r)>0;}).length;
    var need=st.length-reg;
    out.ready=[
      {name:"학생 PIN 등록",v:reg+"/"+st.length+"명",note:need?"아직 "+need+"명이 첫 로그인 전(학번·이름으로 들어와 PIN 을 정합니다)":"모두 등록"},
      {name:"교사 PIN 등록",v:tReg+"/"+tch.length+"명",note:tch.length-tReg?"나머지 선생님은 이름으로 들어와 PIN 을 정하면 됩니다":"모두 등록"},
      {name:"잠긴 계정",v:locked+"명",note:locked?"계정 관리에서 잠금 풀기 또는 PIN 새로 정하게 하기":"없음"},
      {name:"상품권 공개",v:S(c["상품권공개"])==="Y"?"켜짐":"꺼짐(별만 쌓임)",note:S(c["상품권공개"])==="Y"?"학생 화면에 상품권 안내가 나옵니다":"규정이 정해지면 설정에서 Y 로"},
      {name:"첫 수령 기간",v:(db.rows("수령기간")[0]?S(db.rows("수령기간")[0]["시작"])+"~"+S(db.rows("수령기간")[0]["끝"]):"없음"),note:"수령기간 시트에서 조정"},
      {name:"학생 공지사항",v:S(c["공지사항"])?"있음":"비어 있음",note:"설정 공지사항 칸"},
      {name:"이 주의 주제",v:(themeOf(wk)?themeOf(wk).title:"없음"),note:"도서 관리 맨 위"},
      {name:"추천 도서 표지",v:(function(){var t=0,cv=0;db.rows("도서").forEach(function(b){if(S(b["월"])===mon&&S(b["숨김"])!=="Y"){t++;if(S(b["표지"])&&S(b["표지"])!=="-")cv++;}});return cv+"/"+t+"권";})(),note:"표지를 못 찾은 책은 영역 색으로 보입니다"},
      {name:"장서 목록",v:S(c["장서종"])+"종 · "+S(c["장서"])+"권",note:S(c["장서변화"])||S(c["장서목록일"])},
      {name:"로그인 방식",v:S(c["로그인방식"]),note:"핀 = 학번(교사는 이름)+PIN 여섯 자리 · 메일은 쓰지 않습니다"},
      {name:"백업",v:S(c["백업"])||"아직 없음",note:"그달 마지막 날 자동. 편집기에서 backupNow 로 지금 만들 수 있습니다"},
      {name:"글 쓴 학생",v:(function(){var m={};db.rows("글").forEach(function(r){if(S(r["학번"])&&S(r["상태"])!=="down")m[S(r["학번"])]=1;});return Object.keys(m).length+"명";})(),note:"문을 연 뒤 늘어나야 합니다"}
    ];

    out.timing.totalMs=Date.now()-t0;
    out.ok=out.checks.every(function(x){return x.ok;});
    return out;
  }
  function status(){
    var c=conf(),mon=S(c["이달"]),wk=weekKey(env.now(),0);
    return {month:mon,shelf:bookList().length,libChecked:S(c["도서확인"]),libResult:S(c["도서확인결과"]),holdings:S(c["장서"]),
      selVer:S(c["선별판"]),quizWeek:db.rows("퀴즈").filter(function(q){return S(q["상태"])==="출제"&&S(q["주"])===wk;}).length,
      bank:db.rows("퀴즈").filter(function(q){return S(q["상태"])==="예비"&&S(q["월"])===mon;}).length,
      covers:(function(){var t=0,c=0;db.rows("도서").forEach(function(b){if(S(b["월"])===mon&&S(b["숨김"])!=="Y"){t++;if(S(b["표지"])&&S(b["표지"])!=="-")c++;}});return c+"/"+t;})(),
      libDiff:S(c["장서변화"]),quotes:db.rows("문장").length,catalog:S(c["장서목록일"])+" · "+S(c["장서종"])+"종",
      quizBooks:(function(){var bl={};db.rows("도서").forEach(function(b){if(S(b["월"])===mon&&S(b["숨김"])!=="Y")bl[tkey(b["제목"])]=Number(b["권수"])||0;});
        return weekBooksOf(wk).map(function(t){return t+" "+(bl[tkey(t)]||0)+"권";});})(),
      posts:db.rows("글").length,copyDist:(function(){var h={};db.rows("도서").forEach(function(b){if(S(b["월"])===mon&&S(b["숨김"])!=="Y"){var n=Number(b["권수"])||0;h[n]=(h[n]||0)+1;}});return h;})(),
      maxCopies:(function(){var m=0;db.rows("도서").forEach(function(b){if(S(b["월"])===mon&&S(b["숨김"])!=="Y")m=Math.max(m,Number(b["권수"])||0);});return m;})(),loginMode:S(c["로그인방식"]),students:db.rows("명단").length,teachers:db.rows("교사").length};
  }
  return {pickBooks:pickBooks,syncRecvSheet:syncRecvSheet,api:api,status:status,selfTest:selfTest,libProbe:libProbe,giftMail:giftMail,giftMailKey:giftMailKey,refreshLibrary:refreshLibrary,rotateMonth:rotateMonth,maintain:maintain,tick:tick,ensureWeeklyQuiz:ensureWeeklyQuiz,dropPreMade:dropPreMade};
}

