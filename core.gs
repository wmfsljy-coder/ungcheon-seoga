  }
  /* 상품권 배부 기간: "2026-10-05~2026-10-08" 마다 그 앞달 상품권 */
  function giftWindows(c){
    var out=[];
    try{db.rows("수령기간").forEach(function(r){
      var a=S(r["시작"]).slice(0,10),b=S(r["끝"]).slice(0,10)||a;
      if(/^\d{4}-\d{2}-\d{2}$/.test(a)&&/^\d{4}-\d{2}-\d{2}$/.test(b)&&a<=b)out.push({from:a,to:b,mon:prevMonth(a.slice(0,7)),memo:S(r["메모"])});
    });}catch(e){}
    if(out.length)return out.sort(function(x,y){return x.from<y.from?-1:1;});
    S(c["상품권배부"]).split(/[,\n;]+/).forEach(function(r){
      var m=/(\d{4}-\d{2}-\d{2})\s*~\s*(\d{4}-\d{2}-\d{2})/.exec(r);
      if(m)out.push({from:m[1],to:m[2],mon:prevMonth(m[1].slice(0,7))});
    });
    return out;
  }
  function addDays(d,n){return ymd(new Date(Date.parse(d+"T00:00:00Z")+n*86400000));}
  /* 지금 알릴 배부 기간(시작 7일 전 ~ 끝나는 날). 없으면 null */
  function giftNow(c){
    var t=today(env.now());
    return giftWindows(c).filter(function(w){return t>=addDays(w.from,-7)&&t<=w.to;})[0]||null;
  }
  /* 공지사항: 공지 시트(시작~끝 날짜 안, 숨김 아님). 대상 학생·교사·모두 */
  function noticesFor(role,all){
    var t=today(env.now()),out=[];
    /* 설정 시트 '공지사항' 칸(한 줄 = 공지 하나) — 학생·교사 모두에게 */
    if(!all)S(conf()["공지사항"]).split(/\n+/).map(S).filter(Boolean).forEach(function(line,i){
      var m=/^([^:：]{1,30})[:：]\s*(.+)$/.exec(line);
      out.push({id:"conf"+i,title:m?m[1]:line,body:m?m[2]:"",from:"",to:"",who:"모두",pinned:true,ord:i});
    });
    try{db.rows("공지").forEach(function(r){
      if(!S(r["제목"])&&!S(r["내용"]))return;
      var who=S(r["대상"])||"학생",o={id:S(r["id"]),title:S(r["제목"]),body:S(r["내용"]),from:S(r["시작"]).slice(0,10),to:S(r["끝"]).slice(0,10),who:who,hidden:S(r["숨김"])==="Y"};
      if(all){out.push(o);return;}
      if(o.hidden)return;
      if(who!=="모두"&&who!==(role==="student"?"학생":"교사"))return;
      if(o.from&&t<o.from)return;if(o.to&&t>o.to)return;
      out.push(o);
    });}catch(e){}
    return out.sort(function(x,y){if(x.pinned||y.pinned)return (y.pinned?1:0)-(x.pinned?1:0)||(x.ord||0)-(y.ord||0);return (x.from||"")<(y.from||"")?1:(x.from||"")>(y.from||"")?-1:0;});
  }
  function pubConf(c){
    return {name:c["프로그램명"],sub:c["부제"],round:c["차수"],approve:approveMode(c),
      goal:Number(c["주간도장"])||5,weekCap:Number(c["주간도장"])||5,monthCap:Number(c["월간도장"])||0,
      quote:todayQuote(),giftOn:S(c["상품권공개"])==="Y",giftNote:S(c["상품권안내"]),dayCap:Number(c["하루제출상한"])||2,voteN:Number(c["투표후보수"])||8,giftMin:Number(c["상품권기준"])||5,giftTypes:S(c["상품권세종류"])!=="N",limit:LIMIT,areas:S(c["추천방식"])==="장르"?GENRE_NAMES:TEEN_NAMES,lib:libConf(c),libChecked:S(c["도서확인"]),libResult:S(c["도서확인결과"]),loginMode:S(c["로그인방식"])==="구글"?"google":"pin",subjects:S(c["추천분야"]).split(/[,\n]+/).map(S).filter(Boolean),giftWins:giftWindows(c),recvSheet:(function(){try{return db.rows("수령기간").length>0;}catch(e){return false;}})(),giftPlace:S(c["상품권배부장소"]),selVer:S(c["선별판"]),upToDate:S(c["선별판"])==="3"&&S(c["퀴즈판"])==="4"&&S(c["문장판"])==="2",quizBooks:Number(c["퀴즈책수"])||3,monthN:Number(c["이달의권수"])||40,holdings:S(c["장서"]),month:S(c["이달"]),
      period:S(c["이달"])?periodOf(S(c["이달"]),c["추천묶음"]):null,
      privacy:{keep:S(c["보유기간"]),owner:S(c["개인정보담당"])},quizBar:Number(c["퀴즈품질기준"])||6,quizTarget:Number(c["퀴즈문항수"])||5};
  }

  /* 요청 여러 개를 25개씩 나눠 보낸다(독서로에 한꺼번에 몰리지 않게) */
  function httpAll(reqs){
    var out=[];
    for(var i=0;i<reqs.length;i+=25){
      var part=reqs.slice(i,i+25),res=null;
      if(env.deadline&&env.now().getTime()>env.deadline){for(var z=0;z<part.length;z++)out.push(null);continue;}
      try{res=env.http(part);}catch(e){res=null;}
      for(var j=0;j<part.length;j++)out.push(res?res[j]:null);
    }
    return out;
  }
  /* 책 여러 권의 소장·대출 상태. 반환: [{ok,found,total,avail,callNo,loc,due}] (ok=false 는 조회 실패) */
  function libLookup(items,withState,maxPer){
    var L=libConf(),first=httpAll(items.map(function(it){return libSearchReq(L,it.t,1);}));
    var lists=first.map(libData),more=[];
    lists.forEach(function(d,i){if(d&&d.totalCount>50)more.push(i);});
    httpAll(more.map(function(i){return libSearchReq(L,items[i].t,2);})).forEach(function(r,k){
      var d=libData(r);if(d)lists[more[k]].bookList=lists[more[k]].bookList.concat(d.bookList||[]);});
    var out=lists.map(function(d,i){
      if(!d)return {ok:false};
      var copies=libMatch(items[i].t,items[i].a,d.bookList);
      return {ok:true,found:copies.length>0,total:copies.length,avail:0,callNo:callNoOf(copies),
        loc:copies[0]?S(copies[0].locationName):"",copies:copies,
        isbn:(copies.filter(function(x){return S(x.isbn);})[0]||{isbn:""}).isbn.slice(0,13)};
    });
    if(withState){
      var reqs=[],owner=[];
      out.forEach(function(o,i){o.tried=0;o.checked=0;
        if(o.ok)o.copies.slice(0,maxPer||60).forEach(function(b){o.tried++;reqs.push(libStateReq(L,b.bookKey));owner.push(i);});});
      var st=httpAll(reqs),seen={};
      st.forEach(function(r,k){
        var o=out[owner[k]],d=libData(r);if(!d)return;
        seen[owner[k]]=true;o.checked++;        /* 실제로 상태를 받아 본 권수 */
        if(!o.cover&&S(d.coverUrl))o.cover=S(d.coverUrl);
        if(S(d.status)==="대출가능")o.avail++;
        else if(S(d.returnPlanDate)&&(!o.due||S(d.returnPlanDate)<o.due))o.due=S(d.returnPlanDate);
      });
      out.forEach(function(o,i){if(o.ok&&o.found&&!seen[i])o.avail=-1;});   /* 한 권도 확인 못 함 */
    }
    out.forEach(function(o){delete o.copies;});
    return out;
  }
  /* 추천 도서 전체(또는 ids)를 독서로와 맞춰 도서 시트에 적는다 */
  /* 지금 서가에 보이는 책: 숨김이 아니고, 자동 선별분은 이달 것만 */
  /* 서가에 보이는 책: 이번 달 추천 도서(자동 선별 + 선생님이 이번 달에 더한 책)만, 그리고 학교 도서관에 있는 책만.
     자동 선별은 학교 장서 목록에서 뽑은 책이라 처음부터 소장. 예전 '상시 추천 도서'(출처 기본·월 없음)는 보이지 않는다 */
  function visibleBook(b,mon){
    if(S(b["숨김"])==="Y"||!mon||S(b["월"])!==mon)return false;
    return S(b["출처"])==="자동"?S(b["소장"])!=="N":S(b["소장"])==="Y";
  }
  var STATE_CAP=8;
  function refreshLibrary(ids,skip){
    var mon=S(conf()["이달"]);
    var rows=db.rows("도서").filter(function(b){
      if(skip&&skip.indexOf(S(b["id"]))>=0)return false;
      return ids?ids.indexOf(S(b["id"]))>=0:visibleBook(b,mon);});
    if(!rows.length)return {checked:0,found:0,failed:0};
    var res=libLookup(rows.map(function(b){return {t:S(b["제목"]),a:S(b["지은이"])};}),true,STATE_CAP);
    var stamp_=stamp(env.now()),upd={},found=0,failed=0;
    rows.forEach(function(b,i){
      var o=res[i],id=S(b["id"]);
      if(!o.ok){failed++;return;}
      if(o.found){found++;
        upd[id]={"소장":"Y","수동":"","청구기호":o.callNo,"권수":o.total,"대출가능":o.avail<0?"":o.avail,"반납예정":o.due||"","확인":stamp_,
          "표지":o.cover||S(b["표지"]),"확인권수":(o.checked||0),"ISBN":S(b["ISBN"])||o.isbn||""};}
      else if(S(b["출처"])==="자동")upd[id]={"소장":"Y","확인":stamp_};
      else upd[id]={"소장":S(b["수동"])==="Y"?"Y":"N","청구기호":S(b["수동"])==="Y"?S(b["청구기호"]):"","권수":"","대출가능":"","반납예정":"","확인":stamp_};
    });
    /* 여러 권을 찾았는데 한 권도 없다고 나오면 조회가 막혔거나 깨진 것이다. '없음'으로 적으면 서가가 통째로 비게 되므로 그대로 둔다 */
    if(rows.length>=5&&found===0)return {checked:rows.length,found:0,failed:failed,suspect:true};
    db.setMany("도서","id",upd);
    if((!ids||ids.length>=5)&&failed<rows.length)setConf("도서확인",stamp_);   /* 전체 확인이나 새로 뽑은 달 목록 */
    return {checked:rows.length,found:found,failed:failed};
  }
  /* 이번 달 추천 도서: 학교 장서의 대분류(장르)마다 2권 안팎, 모두 합쳐 이달의권수(40)권.
     같은 대분류 안에서는 중분류가 겹치지 않게, 최근 출판 쪽 60% 안에서, 최근 6달에 뽑힌 책·참고서·시리즈 2권째 이상은 빼고.
     force 가 아니면 달이 바뀌었을 때만 새로 뽑는다(매일 자정 확인이 1일에 뽑게 된다) */
  function genreQuota(total){
    var base=Math.floor(total/GENRES.length),q={},rem=total-base*GENRES.length;
    GENRES.forEach(function(g){q[g[1]]=base;});
    for(var i=0;rem>0;i++,rem--)q[GENRE_EXTRA[i%GENRE_EXTRA.length]]++;
    return q;
  }
  /* 영역별 몫: 40권 기준 몫을 권수에 맞춰 늘이거나 줄인다 */
  function teenQuota(total){
    var q={},sum=0;TEEN_AREAS.forEach(function(a){q[a[0]]=Math.floor(a[1]*total/40);sum+=q[a[0]];});
    for(var i=0;sum<total;i++,sum++)q[TEEN_AREAS[i%TEEN_AREAS.length][0]]++;
    return q;
  }
  /* 권장도서 시트에서: 영역마다 몫만큼(같은 영역 안에서는 부수 2권 이상 먼저, 달마다 다르게 섞음), 모자란 영역 몫은 다른 영역에서 */
  function pickTeen(mon,total,used,series){
    var q=teenQuota(total),by={},picks=[],left=[];
    db.rows("권장도서").forEach(function(r){
      if(S(r["뺌"]).toUpperCase()==="Y"||!S(r["제목"]))return;
      var t=shownTitle(r["제목"]),ar=S(r["영역"]);if(TEEN_NAMES.indexOf(ar)<0)ar="인문";
      (by[ar]=by[ar]||[]).push({t:t,a:shownAuthor(r["지은이"]),area:ar,src:S(r["출처"]),n:Number(r["권수"])||0,pub:S(r["출판사"]),year:S(r["발행년"]),isbn:S(r["ISBN"]).slice(0,13),call:S(r["청구기호"])});
    });
    function ok(x){var k=norm(x.t),sk="s|"+series(x.t);if(used[k]||used[sk])return false;used[k]=used[sk]=true;return true;}
    TEEN_NAMES.forEach(function(ar){
      var list=shuffle(by[ar]||[],mon+"|t|"+ar).sort(function(x,y){return (y.n>=2?1:0)-(x.n>=2?1:0);}),n=0;
      list.forEach(function(x){if(n<q[ar]&&ok(x)){picks.push(x);n++;}else left.push(x);});
    });
    shuffle(left,mon+"|t|left").sort(function(x,y){return (y.n>=2?1:0)-(x.n>=2?1:0);}).forEach(function(x){
      if(picks.length<total&&ok(x))picks.push(x);});
    return picks;
  }
  function pickBooks(mon){
    var c=conf();
    var L=libConf(c),total=Number(c["이달의권수"])||40,quota=genreQuota(total);
    var used={};
    function series(t){return norm(S(t).replace(/[\s\[(]*\d+[\])]?\s*$/,""));}
    db.rows("도서").forEach(function(b){
      if(S(b["출처"])!=="자동"||monthsBetween(S(b["월"]),mon)<6){used[norm(shownTitle(b["제목"]))]=true;used["s|"+series(shownTitle(b["제목"]))]=true;}});
    var teen=S(c["추천방식"])==="장르"?[]:pickTeen(mon,total,used,series);
    if(teen.length)quota=genreQuota(Math.max(0,total-teen.length));
    if(teen.length>=total)return writePicks(mon,teen.map(function(x){return {area:x.area,x:x,src:x.src};}));
    var first=httpAll(GENRES.map(function(g){return libCatReq(L,g[0],1);})).map(libData);
    var more=[],rem=total-teen.length;
    first.forEach(function(d,i){
      if(!d)return;
      var tp=Math.ceil((d.totalCount||0)/50),top=Math.max(2,Math.ceil(tp*0.6));   /* 최근 출판 쪽 60% 안에서 */
      if(tp<2)return;
      shuffle(Array.apply(null,{length:top-1}).map(function(_,k){return k+2;}),mon+"|"+GENRES[i][0]).slice(0,quota[GENRES[i][1]]>2?3:2)
        .forEach(function(pg){more.push({i:i,pg:pg});});
    });
    var extra=httpAll(more.map(function(m){return libCatReq(L,GENRES[m.i][0],m.pg);})).map(libData);
    var pool=GENRES.map(function(){return [];});
    function take(d,gi){(d&&d.bookList||[]).forEach(function(b){
      if(S(b.pubFormCode)!=="MA"||S(b.appendixYn)==="Y")return;
      var t=shownTitle(b.title),a=shownAuthor(b.author),vol=/(\d+)[\])]?\s*$/.exec(t);
      if(!t||!a||t.length>40||JUNK.test(b.title)||Number(b.pubYear)<2000)return;
      if(vol&&Number(vol[1])>1&&Number(vol[1])<100)return;   /* 시리즈 2권째부터는 뽑지 않는다 */
      var ci=b.categoryInfo||{};
      pool[gi].push({t:t,a:a,pub:S(b.publisher),year:S(b.pubYear),cat:S(ci.mdesc||ci.ldesc),mcode:S(ci.mcode),
        isbn:S(b.isbn).slice(0,13),call:S(b.callNo).replace(/\s+c\.\s*\d+\s*$/i,"")});
    });}
    first.forEach(function(d,i){take(d,i);});
    extra.forEach(function(d,k){take(d,more[k].i);});
    var picks=[];
    pool.forEach(function(list,gi){
      var want=quota[GENRES[gi][1]],n=0,mids={};
      var order=shuffle(list,mon+"|g"+gi).sort(function(x,y){return (y.isbn?1:0)-(x.isbn?1:0);});   /* 책 소개를 받을 수 있는(ISBN 있는) 책 먼저 */
      [true,false].forEach(function(strict){
        order.forEach(function(x){
          var k=norm(x.t),sk="s|"+series(x.t);
          if(n>=want||used[k]||used[sk]||picks.length>=rem)return;
          if(strict&&x.mcode&&mids[x.mcode])return;   /* 첫 바퀴: 중분류가 겹치지 않게 */
          used[k]=used[sk]=true;mids[x.mcode]=true;n++;picks.push({gi:gi,x:x});
        });
      });
    });
    return writePicks(mon,teen.map(function(x){return {area:x.area,x:x,src:x.src};}).concat(picks.map(function(pk){return {area:GENRES[pk.gi][1],x:pk.x};})));
  }
  function writePicks(mon,picks){
    if(!picks.length)return null;
    var old={};
    db.rows("도서").forEach(function(b){if(S(b["출처"])==="자동"&&S(b["월"])===mon&&S(b["숨김"])!=="Y")old[S(b["id"])]={"숨김":"Y"};});
    if(Object.keys(old).length)db.setMany("도서","id",old);
    /* 같은 기간의 옛 문제 은행도 내린다(새 책으로 다시 만든다) */
    var oldQ={};
    db.rows("퀴즈").forEach(function(q){if(S(q["월"])===mon&&S(q["상태"])==="예비")oldQ[S(q["id"])]={"상태":"교체"};});
    if(Object.keys(oldQ).length)db.setMany("퀴즈","id",oldQ);
    var ids=picks.map(function(pk){
      var id="m"+env.uid();
      db.add("도서",{"id":id,"제목":pk.x.t,"지은이":pk.x.a,"영역":pk.area,"추천":"",
        "추천사":[pk.src?"청소년 권장도서":pk.x.cat,pk.x.pub,pk.x.year?pk.x.year+"년":""].filter(Boolean).join(" · "),"출처":"자동","월":mon,"소장":"Y","청구기호":pk.x.call,"ISBN":pk.x.isbn});
      return id;});
    return ids;
  }
  /* 이번 달(묶음 기간)로 바꾼다. 미리 뽑아 둔 책이 있으면 그것을 쓰고, 없으면 지금 뽑는다.
     force 가 아니면 달이 바뀌었을 때만(매일 자정 확인이 1일에 바꾼다) */
  function rotateMonth(force){
    var c=conf(),now=env.now(),mon=periodOf(monthKey(now),c["추천묶음"]).key;
    if(!force&&S(c["이달"])===mon)return {skipped:true,month:mon};
    if(!force){
      var pre=db.rows("도서").filter(function(b){return S(b["출처"])==="자동"&&S(b["월"])===mon&&S(b["숨김"])!=="Y";}).map(function(b){return S(b["id"]);});
      if(pre.length){
        setConf("이달",mon);setConf("선별판","3");
        var r0=refreshLibrary(pre);
        return {month:mon,picked:pre.length,activated:true,found:r0.found,ids:pre};
      }
    }
    var ids=pickBooks(mon);
    if(!ids)return {month:mon,picked:0,failed:true};
    setConf("이달",mon);setConf("선별판","3");
    var r=refreshLibrary(ids);
    return {month:mon,picked:ids.length,found:r.found,ids:ids};
  }
  /* 다음 달 추천 도서는 7일 전에 미리 뽑고, 그 달 문제 은행까지 만들어 둔다(선생님이 도서 관리에서 미리 보고 뺄 수 있게) */
  function nextPeriodKey(){
    var c=conf(),now=env.now(),cur=S(c["이달"])||periodOf(monthKey(now),c["추천묶음"]).key;
    var ahead=periodOf(monthKey(new Date(now.getTime()+7*86400000)),c["추천묶음"]).key;
    return ahead!==cur&&ahead>cur?ahead:"";
  }
  function prePickNext(){
    var ahead=nextPeriodKey();if(!ahead)return null;
    var have=db.rows("도서").some(function(b){return S(b["출처"])==="자동"&&S(b["월"])===ahead&&S(b["숨김"])!=="Y"&&/청소년 권장도서/.test(S(b["추천사"]))===(S(conf()["추천방식"])!=="장르");}),picked=0;
    if(!have){var ids=pickBooks(ahead);if(!ids)return {month:ahead,failed:true};picked=ids.length;}
    fillDetails(60,ahead);
    /* 문제 은행은 미리 만들지 않는다: 그 달 추천 도서는 선생님 추천으로 계속 늘어나므로,
       그 주가 되어 ensureWeeklyQuiz 가 그때의 서가를 보고 만든다. */
    return {month:ahead,picked:picked,bank:0};
  }
  /* 책 소개·핵심어·표지(독서로 상세, ISBN으로). 소개 "-" = 받아 봤지만 없음 */
  function unent(t){return S(t).replace(/&lt;/g,"<").replace(/&gt;/g,">").replace(/&quot;/g,'"').replace(/&#0?39;/g,"'").replace(/&nbsp;/g," ").replace(/&amp;/g,"&");}
  function fillDetails(limit,forMon){
    var mon=S(conf()["이달"]);
    var rows=db.rows("도서").filter(function(b){
      return (forMon?S(b["월"])===forMon&&S(b["숨김"])!=="Y":visibleBook(b,mon))&&S(b["ISBN"])&&(!S(b["소개"])||!S(b["표지"]));}).slice(0,limit||60);
    if(!rows.length)return 0;
    var res=httpAll(rows.map(function(b){return {url:LIB+"/alpasq/api/detail/info/isbn?isbn="+encodeURIComponent(S(b["ISBN"])),method:"get"};})),upd={},n=0;
    rows.forEach(function(b,i){
      if(!res[i]||res[i].code!==200)return;
      var d=libData(res[i]),p={};
      if(!d){if(!S(b["소개"]))p["소개"]="-";if(!S(b["표지"]))p["표지"]="-";}
      else{
        p["소개"]=unent(S(d.description)).replace(/<[^>]*>/g," ").replace(/\s+/g," ").slice(0,800)||"-";
        p["핵심어"]=(d.keywordList||[]).map(S).filter(Boolean).slice(0,15).join(",");
        p["표지"]=S(b["표지"])&&S(b["표지"])!=="-"?S(b["표지"]):(S(d.coverUrl)||"-");
        if(S(b["소개"]))delete p["소개"];
      }
      upd[S(b["id"])]=p;n++;
    });
    if(n)db.setMany("도서","id",upd);
    return n;
  }
  /* 설치·매일 점검 때 한 번: 옛 판에서 넘어온 기본 추천 정리 */
  /* 명단은 늘 학번순으로 */
  function sortRoster(){
    if(!db.replace)return false;
    var rows=db.rows("명단").slice(),sorted=rows.slice().sort(function(x,y){return S(x["학번"])<S(y["학번"])?-1:S(x["학번"])>S(y["학번"])?1:0;});
    var same=rows.every(function(r,i){return S(r["학번"])===S(sorted[i]["학번"]);});
    if(same)return false;
    db.replace("명단",sorted.map(function(r){var o={};HEAD["명단"].forEach(function(h){o[h]=S(r[h]);});return o;}));
    return true;
  }
  function maintain(){
    try{dropPreMade();}catch(e){}   /* 미리 만들어 둔 문제 정리 */
    /* 설정 시트: 새 판에서 늘어난 항목을 채우고, 설명 칸을 붙인다 */
    var have={};db.rows("설정").forEach(function(r){have[S(r["항목"])]=r;});
    CONF0.forEach(function(kv){if(!have[kv[0]]){setConf(kv[0],kv[1]);}});
    db.rows("설정").forEach(function(r){
      var k=S(r["항목"]),d=CONF_DESC[k];
      if(d&&S(r["설명"])!==d)db.set("설정","항목",k,{"설명":d});
    });
    if(S(conf()["이달의권수"])==="24")setConf("이달의권수","40");
    /* 수령기간 시트: 비어 있으면 한 번 채운다(설정 상품권배부에 적힌 날짜, 없으면 이번 학년도 매달 첫 월요일~목요일) */
    if(S(conf()["수령기간판"])!=="1"){
      try{
        if(!db.rows("수령기간").length){
          var cc=conf(),ws=[];
          S(cc["상품권배부"]).split(/[,\n;]+/).forEach(function(r){var m=/(\d{4}-\d{2}-\d{2})\s*~\s*(\d{4}-\d{2}-\d{2})/.exec(r);if(m)ws.push({"시작":m[1],"끝":m[2],"메모":""});});
          if(!ws.length){var m0=S(cc["수령시작월"])||"2026-10";for(var k=0;k<5;k++){var f0=firstMonday(m0);ws.push({"시작":f0,"끝":addDays(f0,3),"메모":Number(m0.slice(5))+"월 수령"});m0=nextMonthKey(m0);}}
          addRows("수령기간",ws);
        }
        setConf("수령기간판","1");
      }catch(e){}
    }
    /* 상품권 안내를 켠다(2026-09-20 회장님 지시). 관리자가 나중에 N 으로 바꾸면 그대로 둔다 */
    if(S(conf()["상품권판"])!=="1"){setConf("상품권공개","Y");setConf("상품권판","1");}
    /* 첫 공지사항과 이 주의 주제 초안(비어 있을 때 한 번만. 관리자가 고치면 그대로) */
    if(S(conf()["첫안내판"])!=="1"){
      try{
        if(!S(conf()["공지사항"]))setConf("공지사항","웅천 서가 문을 엽니다: 책 한 권 읽고 한 줄만 남기면 도장이 찍혀요. 도장 5개면 별 1개.\n한 주 도장은 자리마다 한 칸씩 다섯 칸(라벨·문장 / 독후감 / 퀴즈 출제 / 퀴즈 풀이 / 만능)이에요. 라벨과 문장은 합쳐서 한 칸이고, 자리가 차면 책갈피가 쌓여 다섯 장마다 만능 도장 1개가 됩니다. 북퀴즈는 월요일마다 새로 나옵니다.\n문화상품권: 별 2개 = 5,000원 1매, 수령 기간에 도서관에서 받아요(그때만 받을 수 있어요). 도장과 별은 계속 쌓입니다.\n로그인이 안 되면: 담임 선생님이나 도서관에 말해 주세요.");
        if(!db.rows("주제").length){
          var TH=[["함께 읽는 첫 주","아무 책이나 좋아요. 한 줄 남기고 도장부터 받아 보기",""],
                  ["과학의 눈으로 보기","실험·우주·몸·기후가 나오는 책 한 권","과학"],
                  ["사람을 이해하는 이야기","소설 속 인물의 마음을 따라가 보기","소설"],
                  ["나와 진로","지금 고민과 맞닿은 책 한 권","자기계발"]];
          var wk0=weekKey(env.now(),0),rows=[];
          TH.forEach(function(t,i){rows.push({"주":weekKey(env.now(),i),"주제":t[0],"설명":t[1],"영역":t[2],"숨김":""});});
          addRows("주제",rows);
        }
        setConf("첫안내판","1");
      }catch(e){}
    }
    /* 메일 인증은 폐기(2026-09-20): 학번·이름 + PIN 여섯 자리로 */
    if(S(conf()["로그인방식"])==="메일")setConf("로그인방식","핀");
    /* 교사 등록 학생도 첫 인증은 거치게(2026-09-20 회장님 지시). 관리자가 나중에 Y 로 바꾸면 그대로 둔다 */
    if(S(conf()["무인증판"])!=="1"){setConf("교사등록무인증","N");setConf("무인증판","1");}
    /* 별 규칙(2026-09-20)부터 한 달 도장 상한은 없음: 옛 기본값 20 → 0 을 한 번만 */
    if(S(conf()["별규칙판"])!=="1"){if(S(conf()["월간도장"])==="20")setConf("월간도장","0");setConf("별규칙판","1");}
    /* 이달 칸이 날짜로 바뀌어 있으면 글자로 다시 적는다 */
    var rawM=db.rows("설정").filter(function(r){return S(r["항목"])==="이달";})[0];
