  function todayQuote(){
    var rows=[];
    try{rows=db.rows("문장").filter(function(r){return S(r["문장"])&&S(r["숨김"])!=="Y";})
      .map(function(r){return [S(r["문장"]),S(r["출처"]),S(r["종류"])||"명언"];});}catch(e){rows=[];}
    if(!rows.length)rows=QUOTES;
    var d=today(env.now()),day=Math.floor(Date.parse(d+"T00:00:00Z")/86400000);
    var order=shuffle(rows.map(function(_,i){return i;}),"quote|"+d.slice(0,4));
