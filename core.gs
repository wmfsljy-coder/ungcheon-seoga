        var monNow=monthKey(env.now());
        var bk=db.rows("도서").filter(function(r){return S(r["숨김"])!=="Y"||!S(r["월"])||monthsBetween(S(r["월"]),monNow)<6;});
        if(bk.length!==db.rows("도서").length)db.replace("도서",bk);
