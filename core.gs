    sm.stamps.forEach(function(x){(by[x.mon]=by[x.mon]||{mon:x.mon,stamps:0,stars:0,bonus:0}).stamps++;});
    sm.bonus.forEach(function(x){(by[x.mon]=by[x.mon]||{mon:x.mon,stamps:0,stars:0,bonus:0}).bonus++;});
    stars.forEach(function(t){var m=t.slice(0,7);(by[m]=by[m]||{mon:m,stamps:0,stars:0,bonus:0}).stars++;});
    return Object.keys(by).sort().reverse().map(function(m){return by[m];});
