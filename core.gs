/* "(청소년을 위한)죽음의 수용소에서", "스무살에 알았더라면 좋았을 것들: 스탠포드대…" → 본제목만 */
function coreTitle(t){return norm(S(t).replace(/^\s*[(\[][^)\]]*[)\]]\s*/,"").split(/\s*[:=]\s*/)[0]);}
/* 번역자 표기가 달라도(리처드 세일러/탈러) 이름 한 토막만 겹치면 같은 저자로 본다 */
function authorOk(ours,theirs){
  var toks=S(ours).split(/[\s,.·]+/).filter(function(x){return x.length>=2;});
  if(!toks.length||S(ours)==="—")return true;
  var th=norm(theirs);
  return toks.some(function(t){return th.indexOf(norm(t))>=0;});
}
/* 같은 책의 사본만 고른다. 같은 제목이 없을 때만 "파친코 1·2" 같은 권차를 인정 */
function libMatch(title,author,list){
  var want=norm(title),exact=[],vol=[];
  (list||[]).forEach(function(b){
    if(!authorOk(author,b.author))return;
    var ct=coreTitle(b.title);
    if(ct===want)exact.push(b);
    else if(ct.indexOf(want)===0&&/^\d+$/.test(ct.slice(want.length)))vol.push(b);
  });
  return exact.length?exact:vol;
}
/* 사본마다 "813.6 손66ㅇ c.39" 처럼 복본 번호가 붙는다. 떼고 나서 가장 많은 사본이 쓰는 청구기호(전집 사본에 끌려가지 않게) */
