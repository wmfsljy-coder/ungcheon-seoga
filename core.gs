function shownTitle(t){return S(S(t).replace(/^\s*[(\[][^)\]]*[)\]]\s*/,"").split(/\s*[:=]\s*/)[0]);}
function shownAuthor(a){
  return S(S(a).split(/[;]/)[0].replace(/\[[^\]]*\]/g," ").replace(/\s*(지음|글·그림|글|저|엮음|편저|편|옮김|역|그림|著|외)\s*$/g,"").replace(/\s+(지음|글·그림|엮음|편저|옮김)(\s.*)?$/,""));
}
function monthKey(d){return ymd(kst(d)).slice(0,7);}
/* "2026-09-24 10:00:00" → 그 주 월요일 "2026-09-21" */
var WOY_={},PM_={};
function weekOfYmd(s){
  var k=S(s).slice(0,10),c=WOY_[k];if(c!==undefined)return c;
  var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(k);
  if(!m)return WOY_[k]="";
  var d=new Date(Date.UTC(Number(m[1]),Number(m[2])-1,Number(m[3]))),dow=(d.getUTCDay()+6)%7;
  return WOY_[k]=ymd(new Date(d.getTime()-dow*86400000));
}
function prevMonth(mon){
  var c=PM_[mon];if(c!==undefined)return c;
  var m=/^(\d{4})-(\d{2})/.exec(mon);var y=Number(m[1]),mm=Number(m[2])-1;if(mm<1){mm=12;y--;}
  return PM_[mon]=y+"-"+p2(mm);
}
/* 설정 '추천묶음'(예: 2026-09~2026-10, 여러 개는 쉼표)에 든 달은 첫 달 추천을 계속 쓴다 */
function periodOf(mon,spec){
  var out={key:mon,from:mon,to:mon};
  S(spec).split(/[,\s]+/).forEach(function(r){
    var m=/^(\d{4}-\d{2})~(\d{4}-\d{2})$/.exec(r);
    if(m&&mon>=m[1]&&mon<=m[2])out={key:m[1],from:m[1],to:m[2]};
  });
  return out;
}
function monthsBetween(a,b){   /* "2026-10","2027-01" → 3 */
  var x=/^(\d{4})-(\d{2})/.exec(a||""),y=/^(\d{4})-(\d{2})/.exec(b||"");
  if(!x||!y)return 999;return (Number(y[1])-Number(x[1]))*12+Number(y[2])-Number(x[2]);
}
/* 받침 있으면 a, 없으면 b. 숫자로 끝나면 읽는 소리로(1984 → 사) */
function josa(w,a,b){
  var t=S(w).replace(/[』」)\]\s.,!?]+$/,""),ch=t.charAt(t.length-1);
  if(/\d/.test(ch))return "013678".indexOf(ch)>=0?a:b;
  var code=ch.charCodeAt(0)-0xAC00;
  if(code<0||code>11171)return b;
  return code%28?a:b;
}
/* 청구기호 맨 앞 숫자(한국십진분류) */
var KDC={"0":"총류(백과사전·도서관)","1":"철학·심리","2":"종교","3":"사회과학","4":"자연과학","5":"기술과학","6":"예술","7":"언어","8":"문학","9":"역사·지리"};
var BADWORDS=/씨발|시발|병신|개새|존나|좆|꺼져|닥쳐|느금|애미|애비/;
/* 학생이 낸 문제의 품질(10점). 책을 펴야 풀리는 문제일수록 높다. onShelf = 지금 서가(추천 도서)에 있는 책 */
function quizQuality(q,onShelf){
  var sc=0,why=[],o=[q.o1,q.o2,q.o3,q.o4].map(S),ans=Number(q.ans);
  if(/\d/.test(S(q.page))){sc+=3;why.push("쪽수");}
  if(onShelf){sc+=2;why.push("추천 도서");}
  var distinct=o.filter(function(x,i){return x&&o.map(norm).indexOf(norm(x))===i;}).length===4;
  if(distinct&&o.every(function(x){return x.length<=40;})){sc+=2;why.push("보기");}
  var lens=o.map(function(x){return x.length;}),avg=(lens.reduce(function(a,b){return a+b;},0)-lens[ans-1])/3;
  if(ans>=1&&ans<=4&&lens[ans-1]<=Math.max(avg*1.8,avg+8)){sc+=1;why.push("정답 안 튐");}
  if(S(q.why).length>=10){sc+=1;why.push("해설");}
  var ql=S(q.q).length;if(ql>=12&&ql<=150){sc+=1;why.push("문제 길이");}
  return {score:sc,why:why};
}
function callNoOf(copies){
  var n={},best="",bn=0;
  copies.forEach(function(b){var c=S(b.callNo).replace(/\s+c\.\s*\d+$/,"");if(c){n[c]=(n[c]||0)+1;if(n[c]>bn){bn=n[c];best=c;}}});
  return best;
}


