  /* 명예의 전당: 달마다 뽑힌 우수 독후감·이달의 한 줄(학급만 보임) */
  function hallOfFame(likes){
    var by={};
    db.rows("글").forEach(function(r){var m=S(r["명예"]);if(!m||!posted(r))return;var o=pub(r);o.likes=(likes||{})[o.id]||0;(by[m]=by[m]||[]).push(o);});
