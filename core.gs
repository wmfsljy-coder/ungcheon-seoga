    if(S(conf()["부제"])==="3학년이 남기는 한 줄")setConf("부제","한 권 읽고, 한 줄 남기기");
    if(S(conf()["프로그램명"])==="웅천 가을 서가")setConf("프로그램명","웅천 서가");
    var upd={},repaired=S(conf()["서가복구"])==="1",seenT={};
    db.rows("도서").forEach(function(b){
      if(S(b["숨김"])==="Y"||!S(b["월"]))return;
      var k=S(b["월"])+"|"+norm(shownTitle(b["제목"]));
      if(seenT[k])upd[S(b["id"])]={"숨김":"Y"};else seenT[k]=true;
    });
    db.rows("도서").forEach(function(b){
