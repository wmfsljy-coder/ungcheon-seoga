      if(!S(b["출처"]))p["출처"]=/^b\d+$/.test(id)?"기본":/^m/.test(id)?"자동":"선생님";
      /* 예전 판은 '학교에 없음'으로 나온 기본 추천을 자동으로 숨겼다. 조회가 헛돌면 서가가 통째로 비는 원인이라 없앴고,
         그때 숨겨진 책은 한 번 되살린다(소장 표시도 지워 다음 확인 때 다시 맞춘다) */
      if(!repaired&&/^b\d+$/.test(id)&&S(b["숨김"])==="Y"&&S(b["소장"])==="N"){p["숨김"]="";p["소장"]="";}
      if(Object.keys(p).length)upd[id]=Object.assign(upd[id]||{},p);
    });
    if(Object.keys(upd).length)db.setMany("도서","id",upd);
    if(!repaired)setConf("서가복구","1");
  }
  /* ── 북퀴즈 ──
     추천 도서를 뽑으면 그 기간의 '문제 은행'을 미리 만들어 둔다(상태 예비, 월=기간). 책 내용을 지어내지 않고 독서로 자료만 쓴다.
       about   : 책 소개글(제목·지은이는 ○○로 가림) → 어느 책인가
       keyword : 그 책이 다루는 낱말(소개글에 실제로 나오는 핵심어만)
       author  : 지은이 / call·kdc : 청구기호·분야
     매주 월요일: 이번 주 퀴즈 책을 퀴즈책수(3)권 이하로 정하고, ① 그 책들의 품질 좋은 학생 문제 ② 모자라면 은행 문제로 채운다.
