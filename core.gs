  function monthlyPicks(mons){
    var likes=likeCount(),votes=tally(),covers={},out={mons:mons,labels:{},reviews:{}};
    db.rows("도서").forEach(function(b){if(S(b["표지"]))covers[norm(shownTitle(b["제목"]))]=S(b["표지"]);});
    mons.forEach(function(m){
