      out.labels[m]=ps.filter(function(r){return S(r["종류"])==="label";}).map(function(r){var o=full(r,votes);o.likes=likes[o.id]||0;o.honor=S(r["명예"]);o.cover=covers[norm(shownTitle(o.title))]||"";return o;})
        .sort(function(x,y){return y.likes-x.likes||y.votes-x.votes;}).slice(0,30);
      out.reviews[m]=ps.filter(function(r){return S(r["종류"])==="review";}).map(function(r){var o=full(r,votes);o.likes=likes[o.id]||0;o.honor=S(r["명예"]);return o;})
        .sort(function(x,y){return (y.likes+y.votes*2)-(x.likes+x.votes*2);}).slice(0,15);
