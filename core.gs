  var QSTOP=/^(소설|문학|한국소설|장편소설|단편소설|청소년|청소년소설|청소년문학|성장|성장소설|에세이|산문|시|시집|일반|교양|인문|인문학|책|이야기|삶|인생|한국|외국|세계|현대|번역|고등학생|학생|어린이|소년|소녀|국내|해외|과학|사회|역사|예술|만화|웹툰|그림|사진|경제|경영|자기계발|건강|여행|종교|컴퓨터|지금|요즘|오늘|우리|사람|세상|시대|사회|마음|생각|이유|방법|시간|자신|작가|저자|독자|작품|문제|세계|미래|이번|처음)$/;
  /* 글 안에 w 가 낱말로 나오는가: 앞은 한글이 아니고, 뒤는 한글이 아니거나 조사 */
  function isWord(text,w){
    var t=S(text),i=-1;
    while((i=t.indexOf(w,i+1))>=0){
      var pre=t.charAt(i-1),post=t.charAt(i+w.length),post2=t.slice(i+w.length,i+w.length+2);
      var preOk=!pre||!/[가-힣]/.test(pre);
      var postOk=!post||!/[가-힣]/.test(post)||/^(은|는|이|가|을|를|의|에|와|과|도|로|만|이다|으로|에서|처럼|까지|부터|보다|이라|라는|이란|란)/.test(post2+" ");
      if(preOk&&postOk)return true;
    }
    return false;
  }
  function addRows(t,list){if(!list.length)return;if(db.addMany)db.addMany(t,list);else list.forEach(function(o){db.add(t,o);});}
  function tkey(t){return norm(shownTitle(t));}
  function qKind(q){return S(q["품질근거"]).replace(/^자동:/,"");}
  /* 추천 도서가 바뀌면 이번 주 자동 문제도 새 책으로(아직 아무도 안 풀었을 때만) */
  function renewWeekAuto(force){
    var wk=weekKey(env.now(),0);
    if(!force&&db.rows("퀴즈응답").some(function(r){return S(r["주"])===wk;}))return 0;
    var upd={};
    db.rows("퀴즈").forEach(function(q){if(S(q["상태"])==="출제"&&S(q["주"])===wk&&S(q["출처"])==="자동")upd[S(q["id"])]={"상태":"교체"};});
    if(Object.keys(upd).length)db.setMany("퀴즈","id",upd);
    return Object.keys(upd).length;
  }
  /* 한 기간의 추천 도서(문제 재료: 소개글·핵심어·청구기호) */
  function periodBooks(mon){
    return db.rows("도서").filter(function(r){
      return S(r["월"])===mon&&S(r["숨김"])!=="Y"&&(S(r["출처"])==="자동"?S(r["소장"])!=="N":S(r["소장"])==="Y");
    }).map(function(r){
      var intro=S(r["소개"]);intro=intro==="-"?"":unent(intro).replace(/<[^>]*>/g," ");
      var b={id:S(r["id"]),t:S(r["제목"]),a:S(r["지은이"]),s:S(r["영역"]),call:S(r["청구기호"]),intro:intro};
      b.kw=S(r["핵심어"]).split(",").map(S).filter(function(k){return k.length>=2&&k.length<=12&&!QSTOP.test(k)&&GENRE_NAMES.indexOf(k)<0&&TEEN_NAMES.indexOf(k)<0&&isWord(intro,k)&&S(r["추천사"]).indexOf(k)<0;});
      return b;
    }).filter(function(b){return b.a&&b.a!=="—";});
  }
  /* 문제 만들기 도구: books 는 같은 기간의 책(오답 보기를 여기서 가져온다) */
  function qFactory(books,seed){
    var df={};books.forEach(function(b){var seen={};b.kw.forEach(function(k){var nk=norm(k);if(!seen[nk]){seen[nk]=1;df[nk]=(df[nk]||0)+1;}});});
    function others(b,field,k){
      var seen={},res=[];seen[norm(field(b))]=true;
      shuffle(books,seed+"|"+b.id+"|"+k).forEach(function(x){var v=field(x),nv=norm(v);if(res.length<3&&v&&!seen[nv]){seen[nv]=true;res.push(v);}});
      return res;
    }
    function mask(text,b){
      var t=text,words=[shownTitle(b.t)].concat(shownTitle(b.t).split(/\s+/).filter(function(w){return w.length>=2;}))
        .concat(S(b.a).split(/[\s,·]+/).filter(function(w){return w.length>=2&&!/지음|옮김|엮음|그림|글|저|역|편|외$/.test(w);}));
      words.sort(function(x,y){return y.length-x.length;}).forEach(function(w){t=t.split(w).join("○○");});
      return t;
    }
    /* 소개글에서 책 '내용'을 말하는 문장을 고른다(시리즈·수상·베스트셀러·신작 같은 홍보 문장은 뒤로) */
    var META=/시리즈|\d+\s*권\.|출간|펴낸|베스트셀러|신작|돌아왔다|수상|선정|개정|번째|장편소설이다|작가의|저자의|판매|부 이상|화제작|추천도서|문학상|호평|독자들|이 책은|책이다\.?$/g;
    function excerpt(b){
      var sents=b.intro.split(/(?<=[.!?])\s+/).map(S).filter(function(x){return x.length>=15;});
      if(!sents.length)return "";
      var best=-1,bi=0;
      sents.forEach(function(x,i){
        var sc=-((x.match(META)||[]).length*3)+(x.length>=30&&x.length<=150?2:0)-(i===0?1:0)+(/[『「<"“]/.test(x)?-1:0);
        if(sc>best||best===-1&&i===0){best=sc;bi=i;}
      });
      if(best<1)return "";   /* 내용 문장이 없으면(홍보 문장뿐이면) 소개글 문제로 내지 않는다 */
      var ex=sents[bi];
      if(ex.length<60&&sents[bi+1])ex+=" "+sents[bi+1];
      else if(ex.length<60&&bi>0)ex=sents[bi-1]+" "+ex;
      if(ex.length>170)ex=ex.slice(0,168)+"…";
      ex=mask(ex,b);
      if(norm(ex).indexOf(norm(shownTitle(b.t)))>=0)return "";
      return ex.length>=40?ex:"";
    }
    function build(b,k){
      var right,wrong,q,why;
      if(k==="about"){
        var ex=excerpt(b);if(!ex)return null;
        right="『"+b.t+"』";wrong=others(b,function(x){return "『"+x.t+"』";},k);
        q="다음 소개글은 어떤 책에 대한 것일까요? “"+ex+"”";
        why="『"+b.t+"』("+b.a+")의 소개글입니다.";}
      else if(k==="keyword"){
        var mine={};b.kw.forEach(function(x){mine[norm(x)]=1;});
        var nt=norm(b.t);
        var inTitle=function(x){var nx=norm(x);return nt.indexOf(nx)>=0||nx.indexOf(nt)>=0;};
        var cand=b.kw.filter(function(x){return df[norm(x)]===1&&!inTitle(x);});   /* 제목에 든 낱말은 답이 뻔하므로 빼기 */
        if(!cand.length)return null;
        right=cand[0];wrong=[];var fromBook={};
        shuffle(books.filter(function(x){return x.id!==b.id;}),seed+"|kw|"+b.id).forEach(function(x){
          if(wrong.length>=3||fromBook[x.id])return;
          var w=x.kw.filter(function(y){var ny=norm(y);return df[ny]===1&&!mine[ny]&&!inTitle(y)&&ny.indexOf(norm(right))<0&&norm(right).indexOf(ny)<0;})[0];
          if(w){wrong.push(w);fromBook[x.id]=1;}
        });
        q="『"+b.t+"』에서 중요하게 다루는 것과 가장 관련 깊은 낱말은?";
        why="『"+b.t+"』의 핵심어: "+b.kw.slice(0,6).join(", ")+". 나머지 보기는 다른 추천 도서의 핵심어예요.";}
      else if(k==="author"){
        var one=function(x){return /[,;·]/.test(x.a)||x.a.length>12?"":x.a;};   /* 여러 사람이 함께 쓴 책은 쓰지 않는다 */
        if(!one(b))return null;
        right=b.a;wrong=others(b,one,k);
        q="『"+b.t+"』"+josa(b.t,"을","를")+" 쓴 사람은?";why="『"+b.t+"』"+josa(b.t,"은","는")+" "+b.a+"의 책입니다.";}
      else{
        if(!b.call||!/^\d/.test(b.call))return null;
        if(k==="call"){right=b.call;wrong=others(b,function(x){return /^\d/.test(x.call||"")?x.call:"";},k);
          q="『"+b.t+"』"+josa(b.t,"은","는")+" 우리 학교 도서관 어느 자리에 꽂혀 있을까요? (청구기호)";
          why="『"+b.t+"』의 청구기호는 "+b.call+"입니다. 서가에서 이 번호 순서를 따라가면 찾을 수 있어요.";}
        else{var d=b.call.charAt(0);right=KDC[d];
          wrong=shuffle(Object.keys(KDC).filter(function(x){return x!==d;}),seed+"|"+b.id).slice(0,3).map(function(x){return KDC[x];});
          q="『"+b.t+"』의 청구기호는 "+b.call+"입니다. 맨 앞 숫자로 알 수 있는 이 책의 분야는?";
          why="청구기호 첫 숫자 "+d+josa(d,"은","는")+" "+KDC[d]+"입니다. (0 총류 · 1 철학 · 2 종교 · 3 사회과학 · 4 자연과학 · 5 기술과학 · 6 예술 · 7 언어 · 8 문학 · 9 역사)";}
      }
      if(!right||!wrong||wrong.length<3)return null;
      return {right:right,wrong:wrong,q:q,why:why};
    }
    return {build:build};
  }
  function qRow(b,k,x,seed,extra){
    var opts=shuffle([x.right].concat(x.wrong),seed+"|opt|"+b.id+"|"+k),o={"id":"q"+env.uid(),"시각":stamp(env.now()),"차수":conf()["차수"],
      "책제목":b.t,"쪽수":"","문제":x.q,"보기1":opts[0],"보기2":opts[1],"보기3":opts[2],"보기4":opts[3],"정답":opts.indexOf(x.right)+1,"해설":x.why,
      "학번":"","반":"도서관","출처":"자동","품질근거":"자동:"+k};
    Object.keys(extra||{}).forEach(function(h){o[h]=extra[h];});
    return o;
  }
  var BANK_KINDS=["about","keyword","author","call","kdc"];
  /* 한 기간의 문제 은행: 책마다 소개글·핵심어·지은이·청구기호(또는 분야) 문제를 만들어 '예비'로 둔다. 이미 있으면 그대로 */
  /* 그 달 서가의 문제 은행. 한 달에 한 번이 아니라 **문제가 아직 없는 책만** 채운다.
     선생님 추천 도서가 달 중간에 들어와도 그 책 문제가 다음 주에 나올 수 있게. */
  function buildBank(mon){
    if(!mon)return 0;
    var rows=db.rows("퀴즈");
    var books=periodBooks(mon);if(books.length<4)return 0;
    var had={};
    rows.forEach(function(q){if(S(q["월"])===mon&&S(q["상태"])==="예비")had[tkey(q["책제목"])]=1;});
    var todo=books.filter(function(b){return !had[tkey(b.t)];});
    if(!todo.length)return 0;
    var F=qFactory(books,"bank|"+mon),out=[],seen={};
    rows.forEach(function(q){seen[norm(q["문제"])]=1;});
    todo.forEach(function(b,i){
      ["about","keyword","author",i%2?"call":"kdc"].forEach(function(k){
        var x=F.build(b,k);if(!x||seen[norm(x.q)])return;seen[norm(x.q)]=1;
        out.push(qRow(b,k,x,"bank|"+mon,{"상태":"예비","주":"","월":mon}));
      });
    });
    if(out.length)addRows("퀴즈",out);
    return out.length;
  }
  /* 미리 만들어 둔 문제를 시트에서 지운다.
     - 다음 달치로 미리 만들어 둔 자동 문제 은행(상태 예비)
     - 아직 오지 않은 주에 걸린 출제 문제
     학생이 낸 문제(대기)와 지난 기록은 건드리지 않는다. */
  function dropPreMade(){
    var mon=S(conf()["이달"]),wk=weekKey(env.now(),0),n=0;
    var keep=db.rows("퀴즈").filter(function(q){
      var st=S(q["상태"]);
      if(st==="예비"&&S(q["출처"])==="자동"&&mon&&S(q["월"])&&S(q["월"])>mon){n++;return false;}
      return true;
    });
    if(n)db.replace("퀴즈",keep);
    return n;
  }
  function ensureWeeklyQuiz(){
    try{dropPreMade();}catch(e){}
    var c=conf(),now=env.now(),wk=weekKey(now,0),target=Number(c["퀴즈문항수"])||5,bar=Number(c["퀴즈품질기준"])||6;
    var maxB=Number(c["퀴즈책수"])||3,mon=S(c["이달"]);
    /* 같은 주에 같은 문제가 두 번 이상 출제돼 있으면 하나만 남긴다 */
    var rows=db.rows("퀴즈"),seenQ={},dup={};
    rows.forEach(function(q){
      if(S(q["상태"])!=="출제"||!S(q["주"]))return;
      var k=S(q["주"])+"|"+norm(q["문제"]);
      if(seenQ[k])dup[S(q["id"])]={"상태":"중복"};else seenQ[k]=true;
    });
    if(Object.keys(dup).length){db.setMany("퀴즈","id",dup);rows=db.rows("퀴즈");}
    var live=rows.filter(function(q){return S(q["상태"])==="출제"&&S(q["주"])===wk;});
    var need=target-live.length;if(need<=0)return {added:0,week:wk,books:weekBooksOf(wk)};
    if(mon){try{buildBank(mon);}catch(e){}rows=db.rows("퀴즈");}
    var keys=shelfKeys();
    /* 이번 주 퀴즈 책(최대 maxB권): 이미 출제된 책 → 품질 좋은 학생 문제가 있는 책 → 은행 문제가 있는 책(아직 안 나온 책, 다른 장르 먼저) */
    var wb={},books=[],genres={};
    function addB(t){var k=tkey(t);if(wb[k])return true;if(books.length>=maxB)return false;wb[k]=1;books.push(S(t));var b=keys[k];if(b)genres[b.s]=1;return true;}
    live.forEach(function(q){var k=tkey(q["책제목"]);if(!wb[k]){wb[k]=1;books.push(S(q["책제목"]));var b=keys[k];if(b)genres[b.s]=1;}});
    var usedStu={};live.forEach(function(q){if(S(q["학번"]))usedStu[S(q["학번"])]=1;});
    var cand=rows.filter(function(q){return S(q["상태"])==="대기"&&S(q["출처"])!=="자동"&&(Number(q["품질"])||0)>=bar&&onShelf(q["책제목"],keys);})
      .sort(function(x,y){return (Number(y["품질"])||0)-(Number(x["품질"])||0)||(S(x["시각"])<S(y["시각"])?-1:1);});
    cand.forEach(function(q){if(!(S(q["학번"])&&usedStu[S(q["학번"])]))addB(q["책제목"]);});
    var usedBefore={};
    rows.forEach(function(q){if(S(q["상태"])==="출제"&&S(q["주"])&&S(q["주"])!==wk){var k=tkey(q["책제목"]);usedBefore[k]=(usedBefore[k]||0)+1;}});
    var bankBy={};
    rows.forEach(function(q){if(S(q["상태"])==="예비"&&S(q["월"])===mon&&onShelf(q["책제목"],keys))(bankBy[tkey(q["책제목"])]=bankBy[tkey(q["책제목"])]||[]).push(q);});
    /* 책 내용을 묻는 문제(소개글·핵심어)가 있는 책을 먼저 */
    function content(k){return (bankBy[k]||[]).filter(function(q){var x=qKind(q);return x==="about"||x==="keyword";}).length;}
    var copies={};db.rows("도서").forEach(function(b){if(S(b["월"])===mon&&S(b["숨김"])!=="Y")copies[tkey(b["제목"])]=Number(b["권수"])||0;});
    var order=shuffle(Object.keys(bankBy).sort(),wk+"|books").sort(function(x,y){return (usedBefore[x]||0)-(usedBefore[y]||0)||(copies[y]||0)-(copies[x]||0)||(content(x)?0:1)-(content(y)?0:1);});
    /* 부수 많은 책부터: 5권 이상 → 3~4권 → 나머지 묶음마다 세 바퀴(내용 문제·장르 다양) */
    function tier(k){var n=copies[k]||0;return n>=5?0:n>=3?1:2;}
    [0,1,2].forEach(function(ti){[[true,true],[true,false],[false,false]].forEach(function(p){
      order.forEach(function(k){
        if(books.length>=maxB||wb[k]||tier(k)!==ti)return;
        var b=keys[k],g=b?b.s:"";
        if(p[0]&&!content(k))return;          /* 1·2바퀴: 내용 문제가 있는 책만 */
        if(p[1]&&genres[g])return;            /* 1바퀴: 장르도 겹치지 않게 */
        addB(bankBy[k][0]["책제목"]);
      });
    });});
    /* ① 학생 문제(한 학생 한 문제) */
    var per={},fromStu=0,fromBank=0,made=0,upd={};
    live.forEach(function(q){var k=tkey(q["책제목"]);per[k]=(per[k]||0)+1;});
    cand.forEach(function(q){
      if(need<=0)return;
      var k=tkey(q["책제목"]),st=S(q["학번"]);
      if(!wb[k]||(st&&usedStu[st]))return;
      if(st)usedStu[st]=1;
      upd[S(q["id"])]={"상태":"출제","주":wk,"차수":c["차수"]};per[k]=(per[k]||0)+1;need--;fromStu++;
    });
    /* ② 은행 문제: 책마다 고르게, 종류는 소개글 → 핵심어 → 지은이 → 청구기호 순 */
    var PR={about:0,keyword:1,author:2,call:3,kdc:3};
    Object.keys(bankBy).forEach(function(k){bankBy[k].sort(function(x,y){var a=PR[qKind(x)],b=PR[qKind(y)];return (a==null?9:a)-(b==null?9:b);});});
    /* 청구기호·분야(도서관 활용) 문제는 한 주에 하나까지 */
    var libN=live.filter(function(q){var x=qKind(q);return x==="call"||x==="kdc";}).length;
    books.forEach(function(t){var k=tkey(t);if(bankBy[k])bankBy[k]=bankBy[k].filter(function(q,i,a){var x=qKind(q);return !(x==="call"||x==="kdc")||a.indexOf(q)===a.findIndex(function(z){var y=qKind(z);return y==="call"||y==="kdc";});});});
    while(need>0){
      var pickK=null;
      books.forEach(function(t){var k=tkey(t);
        var avail=(bankBy[k]||[]).filter(function(q){var x=qKind(q);return libN<1||!(x==="call"||x==="kdc");});
        if(avail.length&&(pickK===null||(per[k]||0)<(per[pickK]||0)))pickK=k;});
      if(pickK===null)break;
      var qi=bankBy[pickK].findIndex(function(q){var x=qKind(q);return libN<1||!(x==="call"||x==="kdc");}),q=bankBy[pickK].splice(qi,1)[0];
      if(qKind(q)==="call"||qKind(q)==="kdc")libN++;
      upd[S(q["id"])]={"상태":"출제","주":wk,"차수":c["차수"]};per[pickK]=(per[pickK]||0)+1;need--;fromBank++;
    }
    if(Object.keys(upd).length)db.setMany("퀴즈","id",upd);
    /* ③ 은행이 모자라면 그 자리에서 만든다(같은 책들로, 이미 있는 문제와 겹치지 않게) */
    if(need>0&&mon){
      var pb=periodBooks(mon),F=qFactory(pb,wk),have={},out=[];
      db.rows("퀴즈").forEach(function(q){have[norm(q["문제"])]=1;});
      pb.filter(function(b){return wb[tkey(b.t)];}).forEach(function(b){
        BANK_KINDS.forEach(function(k){
          if(need<=0)return;
          var x=F.build(b,k);if(!x||have[norm(x.q)])return;have[norm(x.q)]=1;
          out.push(qRow(b,k,x,wk,{"상태":"출제","주":wk,"월":mon}));need--;made++;
        });
      });
      addRows("퀴즈",out);
    }
    return {added:fromStu+fromBank+made,student:fromStu,auto:fromBank+made,bank:fromBank,week:wk,books:books};
  }
  /* 그 주 퀴즈에 나온 책들 */
  function weekBooksOf(wk){
    var seen={},out=[];
    db.rows("퀴즈").forEach(function(q){if(S(q["상태"])==="출제"&&S(q["주"])===wk){var k=tkey(q["책제목"]);if(!seen[k]){seen[k]=1;out.push(S(q["책제목"]));}}});
    return out;
  }

  /* 매일 세 번(7시·15시·0시) 도는 일: 달이 바뀌었으면 이번 달 추천 도서를 새로 뽑고, 보이는 책의 대출 상태를 새로 받는다 */
  /* 독서로 연결 확인: 분류 조회 한 건. 응답이 오고 책이 한 권이라도 있어야 '된다'고 본다 */
  function libProbe(){
    var r=httpAll([libCatReq(libConf(),"001000000",1)])[0],d=libData(r);
    if(!r)return {ok:false,why:"독서로에 연결되지 않음(응답 없음)"};
    if(!d)return {ok:false,why:"독서로가 오류를 돌려줌(코드 "+r.code+")"};
    if(!(d.totalCount>0))return {ok:false,why:"응답은 오지만 책이 0권 — 학교코드·교육청코드를 확인하세요"};
    return {ok:true,count:d.totalCount};
  }
  function libAlive(){return libProbe().ok;}
  /* 학교 장서 전체(독서로): 대분류마다 모든 쪽을 받아 같은 책(종)끼리 묶어 '장서목록' 시트에. 하나라도 못 받으면 덮어쓰지 않는다 */
  function crawlCatalog(){
    if(!db.replace)return null;
    var d=libData(httpAll([{url:LIB+"/alpasq/api/category/list?type=B",method:"get"}])[0]);
    var L=libConf(),cats=(d&&d.categoryList||[]).map(function(x){return {code:S(x.lCategoryCode)};}).filter(function(x){return x.code;});
    if(!cats.length)return {failed:true};
    var first=httpAll(cats.map(function(x){return libCatReq(L,x.code,1);})).map(libData),reqs=[],own=[];
    if(first.some(function(x){return !x;}))return {failed:true};
    first.forEach(function(r,i){var pages=Math.ceil((r.totalCount||0)/50);for(var pg=2;pg<=pages;pg++){reqs.push(libCatReq(L,cats[i].code,pg));own.push(i);}});
    var rest=httpAll(reqs).map(libData);
    if(rest.some(function(x){return !x;}))return {failed:true};
    var by={},n=0;
    function take(list){(list||[]).forEach(function(b){
      n++;var k=S(b.speciesKey)||(norm(b.title)+"|"+norm(b.author)),o=by[k];
      if(!o)o=by[k]={t:S(b.title),a:S(b.author),pub:S(b.publisher),year:S(b.pubYear),calls:{},n:0,cat:S(b.categoryInfo&&b.categoryInfo.ldesc),mid:S(b.categoryInfo&&b.categoryInfo.mdesc),isbn:S(b.isbn).slice(0,13),loc:S(b.locationName)};
      o.n++;var cn=S(b.callNo).replace(/\s+c\.\s*\d+\s*$/i,"");o.calls[cn]=(o.calls[cn]||0)+1;});}
    first.forEach(function(r){take(r.bookList);});
    rest.forEach(function(r){take(r.bookList);});
    var rows=Object.keys(by).map(function(k){var o=by[k],cn=Object.keys(o.calls).sort(function(x,y){return o.calls[y]-o.calls[x];})[0]||"";
      return {"제목":o.t,"지은이":o.a,"출판사":o.pub,"발행년":o.year,"청구기호":cn,"권수":o.n,"분야":o.cat,"중분류":o.mid,"ISBN":o.isbn,"자료실":o.loc};})
      .sort(function(x,y){return x["청구기호"]<y["청구기호"]?-1:x["청구기호"]>y["청구기호"]?1:0;});
    var was=Number(conf()["장서"])||0;
    db.replace("장서목록",rows);
    setConf("장서",String(n));setConf("장서종",String(rows.length));setConf("장서목록일",today(env.now()));
    var diff=was?n-was:0;
    setConf("장서변화",today(env.now())+" · "+n+"권"+(was?(diff>0?" (지난번보다 +"+diff+"권 늘었습니다)":diff<0?" ("+(-diff)+"권 줄었습니다)":" (지난번과 같습니다)"):""));
    return {copies:n,titles:rows.length,diff:diff};
  }
  function libCount(){
    var d=libData(httpAll([{url:LIB+"/alpasq/api/category/list?type=B",method:"get"}])[0]);
    var L=libConf(),codes=(d&&d.categoryList||[]).map(function(x){return S(x.lCategoryCode);}).filter(Boolean);
    if(!codes.length)return null;
    var res=httpAll(codes.map(function(code){var q=libCatReq(L,code,1);q.body.display=1;return q;})),n=0;
    for(var i=0;i<res.length;i++){var x=libData(res[i]);if(!x)return null;n+=Number(x.totalCount)||0;}
    return n;
  }
  /* 목록에 없는 책으로 쓴 글의 청구기호·표지를 나중에 채운다(제출할 때 기다리지 않게). 표지 "-" = 찾아봤지만 없음 */
  function fillPostInfo(limit){
    var rows=db.rows("글").filter(function(r){return S(r["도서id"])==="free"&&!S(r["청구기호"])&&!S(r["표지"])&&S(r["상태"])!=="down";}).slice(0,limit||20);
    if(!rows.length)return 0;
    var res=libLookup(rows.map(function(r){return {t:S(r["책제목"]),a:S(r["지은이"])};}),true,1),n=0;
    rows.forEach(function(r,i){
      var o=res[i];if(!o.ok)return;
      db.set("글","id",S(r["id"]),{"청구기호":o.found?o.callNo:"","표지":o.found&&o.cover?o.cover:"-"});n++;});
    return n;
  }
  function tick(){
    maintain();
    var p=libProbe();
    /* 독서로가 안 되면 퀴즈만(지난번에 받아 둔 청구기호로 만든다) */
    if(!p.ok){setConf("도서확인결과",stamp(env.now())+" · "+p.why);
      return {down:true,why:p.why,rotate:null,lib:{checked:0,found:0,failed:0},quiz:ensureWeeklyQuiz()};}
    var r=rotateMonth(S(conf()["선별판"])!=="3"),l=refreshLibrary(null,r&&r.ids),filled=0,cc=conf();
    try{fillDetails(60);}catch(e){}
    if(S(cc["장서확인"])!==today(env.now())){
      try{var hn=libCount();if(hn){setConf("장서",String(hn));setConf("장서확인",today(env.now()));}}catch(e){}
    }
    try{filled=fillPostInfo(20);}catch(e){}
    try{syncRecvSheet();}catch(e){}
    /* 장서목록 시트는 달마다 한 번 새로 */
    if(S(conf()["장서목록일"]).slice(0,7)!==monthKey(env.now()))try{crawlCatalog();}catch(e){}
    setConf("도서확인결과",stamp(env.now())+" · "+(l.suspect?"책 제목 조회가 한 권도 맞지 않음 — 지난 값을 그대로 둠":"정상 · "+(r&&r.picked?"이번 달 추천 도서 "+r.picked+"권 새로 뽑음"+(l.checked?", ":""):"")+(l.checked||!(r&&r.picked)?l.checked+"권 대출 상태 확인":"")+(l.failed?", "+l.failed+"권 응답 없음":"")));
    if(r&&r.picked)try{renewWeekAuto();}catch(e){}
    /* 퀴즈판 3(2026-09-20): 이번 주 문제를 부수 많은 책에서 한 번 다시 낸다 */
    if(S(conf()["퀴즈판"])!=="4")try{renewWeekAuto(true);}catch(e){}
    setConf("퀴즈판","4");
    /* 퀴즈는 청구기호를 받아 온 뒤에 채운다(첫 실행에서도 자동 문제가 나오게) */
    var qz=ensureWeeklyQuiz(),nx=null;
    try{nx=prePickNext();}catch(e){}
    return {rotate:r,lib:l,filled:filled,quiz:qz,next:nx};
  }

  /* 도서 검색: 학교 도서관 소장 도서를 찾아 같은 책끼리 묶고 대출 가능 여부를 붙인다(10분 보관) */
  function libSearch(a,p){
    var q=S(p.q).slice(0,60);
    if(!q)fail("찾을 책 제목이나 지은이를 입력해 주세요.");
    var key="lib|"+norm(q),hit=env.cacheGet?env.cacheGet(key):null;
    if(hit)return JSON.parse(hit);
    var L=libConf(),d=libData(httpAll([libSearchReq(L,q,1)])[0]);
    if(!d)fail("독서로가 응답하지 않습니다. 잠시 뒤 다시 찾아 주세요.");
    var groups=[],by={};
    (d.bookList||[]).forEach(function(b){
      var k=S(b.speciesKey)||(norm(b.title)+"|"+norm(b.author));
      if(!by[k]){by[k]={t:shownTitle(b.title)||S(b.title),full:S(b.title),a:shownAuthor(b.author),pub:S(b.publisher),year:S(b.pubYear),
        cat:S(b.categoryInfo&&(b.categoryInfo.mdesc||b.categoryInfo.ldesc)),copies:[],loc:S(b.locationName)};groups.push(by[k]);}
      by[k].copies.push(b);
    });
    groups=groups.slice(0,12);
    var reqs=[],owner=[];
    groups.forEach(function(g,i){g.copies.slice(0,6).forEach(function(b){reqs.push(libStateReq(L,b.bookKey));owner.push(i);});});
    var st=httpAll(reqs);
    groups.forEach(function(g){g.checked=0;g.avail=0;g.due="";g.cover="";});
    st.forEach(function(r,k){
      var g=groups[owner[k]],x=libData(r);if(!x)return;
      g.checked++;if(!g.cover&&S(x.coverUrl))g.cover=S(x.coverUrl);
      if(S(x.status)==="대출가능")g.avail++;
      else if(S(x.returnPlanDate)&&(!g.due||S(x.returnPlanDate)<g.due))g.due=S(x.returnPlanDate);
    });
    var out={q:q,total:d.totalCount||0,items:groups.map(function(g){
      return {t:g.t,full:g.full,a:g.a,pub:g.pub,year:g.year,cat:g.cat,loc:g.loc,call:callNoOf(g.copies),
        total:g.copies.length,checked:g.checked,avail:g.avail,due:g.due,cover:g.cover};})};
    if(env.cachePut)try{env.cachePut(key,JSON.stringify(out),600);}catch(e){}
    return out;
  }

  /* 글 한 편의 청구기호: 추천 도서면 시트 값, 아니면 독서로에서 한 번 찾아본다(실패해도 글은 낸다) */
  function libInfoFor(bookRow){
    return bookRow?{call:S(bookRow["청구기호"]),cover:S(bookRow["표지"])}:{call:"",cover:""};   /* 목록 밖 책은 fillPostInfo 가 나중에 채움 */
  }

  /* ── 누구인가: 구글 계정 이메일로만 판단한다 ── */
  var TEACHER_CLS="선생님";
  function pinMode(){return S(conf()["로그인방식"])!=="구글";}
  function lower(x){return S(x).toLowerCase();}
  /* 이 PC(브라우저)에 기억된 로그인. 토큰은 해시로만 저장 */
