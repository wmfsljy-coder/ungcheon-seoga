    /* 오늘의 문장: 기본 목록에서 시트에 없는 문장을 한 번 채운다(선생님이 숨긴 문장은 그대로) */
    if(S(conf()["문장판"])!=="2"){
      try{
        var haveQ={};db.rows("문장").forEach(function(r){haveQ[S(r["문장"])]=1;});
        addRows("문장",QUOTES.filter(function(q){return !haveQ[q[0]];}).map(function(q){return {"문장":q[0],"출처":q[1],"종류":q[2],"숨김":""};}));
        setConf("문장판","2");
      }catch(e){}
    }
    /* 권장도서 시트: 기본 목록에서 시트에 없는 책을 채운다(사서 선생님이 '뺌'에 Y 한 책·직접 넣은 책은 그대로) */
    if(S(conf()["권장도서판"])!==TEEN_VER){
      try{
        var haveT={};db.rows("권장도서").forEach(function(r){haveT[norm(r["제목"])]=1;});
        addRows("권장도서",TEEN.filter(function(x){return !haveT[norm(x[0])];}).map(function(x){
          return {"제목":x[0],"지은이":x[1],"영역":x[2],"출처":x[3],"권수":x[4],"청구기호":x[5],"ISBN":x[6],"출판사":x[7],"발행년":x[8],"뺌":""};}));
