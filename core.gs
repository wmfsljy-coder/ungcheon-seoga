  /* 담임 알림: 지난번 '확인했어요' 이후 우리 반(담당은 전체)에 생긴 일. 처음이면 최근 7일 */
  function teacherNews(a,c,scope,fin,now){
    var since=a.seen||stamp(new Date(now.getTime()-7*86400000)),first=!a.seen;
    var inScope=function(cls){return seeCls(a,cls);};
    var posts=scope.filter(function(r){return S(r["학번"])&&S(r["시각"])>since;})
      .map(function(r){return {cls:S(r["반"]),name:S(r["이름"]),kind:S(r["종류"]),title:S(r["책제목"]),at:S(r["시각"]),status:S(r["상태"])};});
    var regs=db.rows("명단").filter(function(r){return inScope(S(r["반"]))&&S(r["동의"])>since;})
      .map(function(r){return {cls:S(r["반"]),name:S(r["이름"]),at:S(r["동의"])};});
    var done=fin.filter(function(f){return f.at&&f.at>since;});
    /* 매월 1~10일: 지난달 상품권 대상(이달 들어 '확인했어요'를 누르기 전까지) */
    var gift=null,dk=deskFor(c);   /* 기간만 씀 — 명단은 바로 아래에서 giftRows(a,…) 로 자른다 */
    if(!dk.none&&(!a.seen||a.seen<addDays(dk.from,-7)+" 00:00:00")){
      var pm=dk.label,rows=giftRows(a,dk.from).filter(function(x){return x.vouchers>0;});
      gift={label:pm,from:dk.from,to:dk.to,rows:rows.map(function(x){return {cls:x.cls,name:x.name,hakbun:x.hakbun,stars:x.stars,vouchers:x.vouchers,paid:x.paid};})};
    }
    var stu={};db.rows("명단").forEach(function(r){stu[S(r["학번"])]=r;});
    var sinceWeek=weekKey(new Date(Date.parse(since.replace(" ","T")+"+09:00")||now.getTime()),0);
    var picked=db.rows("퀴즈").filter(function(q){var r=stu[S(q["학번"])];
      return r&&inScope(S(r["반"]))&&S(q["상태"])==="출제"&&S(q["주"])>=sinceWeek;})
      .map(function(q){var r=stu[S(q["학번"])];return {cls:S(r["반"]),name:S(r["이름"]),title:S(q["책제목"])};});
    var out={since:since,first:first,posts:posts,regs:regs,done:done,picked:picked,gift:gift};
    if(a.role==="admin"){
      var bar=Number(c["퀴즈품질기준"])||6,sk=shelfKeys();
      out.printQueue=db.rows("글").filter(function(r){return posted(r)&&S(r["종류"])==="label"&&S(r["인쇄"])!=="Y";}).length;
      out.quizWait=db.rows("퀴즈").filter(function(q){return S(q["상태"])==="대기"&&(Number(q["품질"])||0)>=bar&&onShelf(q["책제목"],sk);}).length;
    }
    out.total=posts.length+regs.length+done.length+picked.length+(gift&&gift.rows.length?1:0);
    return out;
  }
  /* 학생별 읽은 책: 게시된 라벨·독후감의 책(내려간 글은 뺌). 담임은 우리 반, 담당은 전체 */
  function readLog(a){
