    db.rows("설정").forEach(function(r){if(S(r["항목"]))c[S(r["항목"])]=S(r["값"]);});
    /* 시트가 "2026-09" 를 날짜로 바꿔 둔 경우 되돌린다 */
    var mm=/^(\d{4}-\d{2})-01( 00:00:00)?$/.exec(S(c["이달"]));if(mm)c["이달"]=mm[1];
